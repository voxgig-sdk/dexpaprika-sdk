{
  "openapi": "3.0.3",
  "info": {
    "title": "DexPaprika API",
    "description": "DexPaprika provides access to comprehensive decentralized exchange (DEX) data, including real-time token prices, liquidity pools, and trading volumes. It is designed for developers creating trading dashboards, portfolio trackers, and DeFi applications.",
    "version": "1.0.0",
    "contact": {
      "name": "DexPaprika API Documentation",
      "url": "https://docs.dexpaprika.com/"
    }
  },
  "servers": [
    {
      "url": "https://api.dexpaprika.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/v1/tokens": {
      "get": {
        "summary": "Get tokens list",
        "description": "Returns a list of tokens available on decentralized exchanges with their current market data",
        "operationId": "getTokens",
        "tags": [
          "Tokens"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Limit the number of results returned",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Offset for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "chain",
            "in": "query",
            "description": "Filter tokens by blockchain network",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ethereum",
                "bsc",
                "polygon",
                "arbitrum",
                "optimism",
                "avalanche"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with tokens data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique token identifier"
                      },
                      "symbol": {
                        "type": "string",
                        "description": "Token symbol"
                      },
                      "name": {
                        "type": "string",
                        "description": "Token name"
                      },
                      "address": {
                        "type": "string",
                        "description": "Token contract address"
                      },
                      "chain": {
                        "type": "string",
                        "description": "Blockchain network"
                      },
                      "price_usd": {
                        "type": "number",
                        "format": "float",
                        "description": "Current price in USD"
                      },
                      "volume_24h": {
                        "type": "number",
                        "format": "float",
                        "description": "24-hour trading volume"
                      },
                      "liquidity_usd": {
                        "type": "number",
                        "format": "float",
                        "description": "Total liquidity in USD"
                      },
                      "price_change_24h": {
                        "type": "number",
                        "format": "float",
                        "description": "24-hour price change percentage"
                      },
                      "last_updated": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp of last data update"
                      }
                    }
                  }
                },
                "example": [
                  {
                    "id": "eth-uniswap-0x1f9840a85d5af5bf1d1762f925bdaddc4201f984",
                    "symbol": "UNI",
                    "name": "Uniswap",
                    "address": "0x1f9840a85d5af5bf1d1762f925bdaddc4201f984",
                    "chain": "ethereum",
                    "price_usd": 6.45,
                    "volume_24h": 125000000,
                    "liquidity_usd": 450000000,
                    "price_change_24h": 2.5,
                    "last_updated": "2024-01-15T12:00:00Z"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests - rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/{token_id}": {
      "get": {
        "summary": "Get token details",
        "description": "Returns detailed information about a specific token including price, volume, and liquidity data",
        "operationId": "getTokenById",
        "tags": [
          "Tokens"
        ],
        "parameters": [
          {
            "name": "token_id",
            "in": "path",
            "description": "Unique token identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with token details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenDetail"
                }
              }
            }
          },
          "404": {
            "description": "Token not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests - rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pools": {
      "get": {
        "summary": "Get liquidity pools",
        "description": "Returns a list of liquidity pools across decentralized exchanges",
        "operationId": "getPools",
        "tags": [
          "Pools"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Limit the number of results returned",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "dex",
            "in": "query",
            "description": "Filter pools by DEX platform",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "uniswap",
                "sushiswap",
                "pancakeswap",
                "quickswap"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with pools data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pool"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/exchanges": {
      "get": {
        "summary": "Get DEX exchanges",
        "description": "Returns a list of decentralized exchanges with their trading volumes and statistics",
        "operationId": "getExchanges",
        "tags": [
          "Exchanges"
        ],
        "responses": {
          "200": {
            "description": "Successful response with exchanges data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Exchange"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickers": {
      "get": {
        "summary": "Get real-time tickers",
        "description": "Returns real-time price tickers for tokens across DEX platforms",
        "operationId": "getTickers",
        "tags": [
          "Market Data"
        ],
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "description": "Comma-separated list of token symbols",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with ticker data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ticker"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/historical/{token_id}": {
      "get": {
        "summary": "Get historical price data",
        "description": "Returns historical price data for a specific token",
        "operationId": "getHistoricalData",
        "tags": [
          "Market Data"
        ],
        "parameters": [
          {
            "name": "token_id",
            "in": "path",
            "description": "Unique token identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start date for historical data (ISO 8601 format)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End date for historical data (ISO 8601 format)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "description": "Time interval for data points",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "15m",
                "1h",
                "4h",
                "1d",
                "1w"
              ],
              "default": "1h"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with historical data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoricalData"
                }
              }
            }
          },
          "404": {
            "description": "Token not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TokenDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique token identifier"
          },
          "symbol": {
            "type": "string",
            "description": "Token symbol"
          },
          "name": {
            "type": "string",
            "description": "Token name"
          },
          "address": {
            "type": "string",
            "description": "Token contract address"
          },
          "chain": {
            "type": "string",
            "description": "Blockchain network"
          },
          "decimals": {
            "type": "integer",
            "description": "Token decimal places"
          },
          "price_usd": {
            "type": "number",
            "format": "float",
            "description": "Current price in USD"
          },
          "volume_24h": {
            "type": "number",
            "format": "float",
            "description": "24-hour trading volume"
          },
          "liquidity_usd": {
            "type": "number",
            "format": "float",
            "description": "Total liquidity in USD"
          },
          "price_change_24h": {
            "type": "number",
            "format": "float",
            "description": "24-hour price change percentage"
          },
          "market_cap": {
            "type": "number",
            "format": "float",
            "description": "Market capitalization in USD"
          },
          "total_supply": {
            "type": "number",
            "format": "float",
            "description": "Total token supply"
          },
          "last_updated": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of last data update"
          }
        }
      },
      "Pool": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique pool identifier"
          },
          "dex": {
            "type": "string",
            "description": "DEX platform name"
          },
          "chain": {
            "type": "string",
            "description": "Blockchain network"
          },
          "address": {
            "type": "string",
            "description": "Pool contract address"
          },
          "token0": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          },
          "token1": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          },
          "liquidity_usd": {
            "type": "number",
            "format": "float",
            "description": "Total liquidity in USD"
          },
          "volume_24h": {
            "type": "number",
            "format": "float",
            "description": "24-hour trading volume"
          },
          "apr": {
            "type": "number",
            "format": "float",
            "description": "Annual percentage rate"
          }
        }
      },
      "Exchange": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Exchange identifier"
          },
          "name": {
            "type": "string",
            "description": "Exchange name"
          },
          "chain": {
            "type": "string",
            "description": "Blockchain network"
          },
          "volume_24h": {
            "type": "number",
            "format": "float",
            "description": "24-hour trading volume"
          },
          "liquidity_usd": {
            "type": "number",
            "format": "float",
            "description": "Total liquidity in USD"
          },
          "trades_24h": {
            "type": "integer",
            "description": "Number of trades in last 24 hours"
          }
        }
      },
      "Ticker": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Token symbol"
          },
          "price_usd": {
            "type": "number",
            "format": "float",
            "description": "Current price in USD"
          },
          "price_change_24h": {
            "type": "number",
            "format": "float",
            "description": "24-hour price change percentage"
          },
          "volume_24h": {
            "type": "number",
            "format": "float",
            "description": "24-hour trading volume"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of ticker data"
          }
        }
      },
      "HistoricalData": {
        "type": "object",
        "properties": {
          "token_id": {
            "type": "string",
            "description": "Token identifier"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Data point timestamp"
                },
                "price": {
                  "type": "number",
                  "format": "float",
                  "description": "Price at timestamp"
                },
                "volume": {
                  "type": "number",
                  "format": "float",
                  "description": "Trading volume"
                },
                "open": {
                  "type": "number",
                  "format": "float",
                  "description": "Opening price"
                },
                "high": {
                  "type": "number",
                  "format": "float",
                  "description": "Highest price"
                },
                "low": {
                  "type": "number",
                  "format": "float",
                  "description": "Lowest price"
                },
                "close": {
                  "type": "number",
                  "format": "float",
                  "description": "Closing price"
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "code": {
            "type": "integer",
            "description": "Error code"
          },
          "message": {
            "type": "string",
            "description": "Detailed error description"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Tokens",
      "description": "Operations related to DEX tokens"
    },
    {
      "name": "Pools",
      "description": "Operations related to liquidity pools"
    },
    {
      "name": "Exchanges",
      "description": "Operations related to decentralized exchanges"
    },
    {
      "name": "Market Data",
      "description": "Real-time and historical market data operations"
    }
  ]
}
