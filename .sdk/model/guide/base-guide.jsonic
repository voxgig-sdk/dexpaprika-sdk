# Guide

guide: {
  metrics: count: entity: 5
  metrics: count: path: 6
  metrics: count: method: 6

  entity: exchange: {
    path: "/v1/exchanges": {
      op: list: method: *GET
    }
  }

  entity: historical: {
    path: "/v1/historical/{token_id}": {
      rename: param: "token_id": *"id"
      op: load: method: *GET
    }
  }

  entity: pool: {
    path: "/v1/pools": {
      op: list: method: *GET
    }
  }

  entity: ticker: {
    path: "/v1/tickers": {
      op: list: method: *GET
    }
  }

  entity: token: {
    path: "/v1/tokens": {
      op: list: method: *GET
    }
    path: "/v1/tokens/{token_id}": {
      rename: param: "token_id": *"id"
      op: load: method: *GET
    }
  }

}