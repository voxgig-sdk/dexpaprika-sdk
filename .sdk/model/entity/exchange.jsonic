# Entity: exchange

main: kit: entity: exchange: {

  alias: field: {}

  fields: [
    {
      name: "chain"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "liquidity_usd"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "trades_24h"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "volume_24h"
      req: false
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "exchange"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/v1/exchanges"
          parts: [
            "v1"
            "exchanges"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
