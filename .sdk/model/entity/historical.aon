# Entity: historical

main: kit: entity: historical: {

  alias: field: {}

  fields: [
    {
      name: "data"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "token_id"
      req: false
      short: "Token identifier"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "historical"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "token_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "end"
                orig: "end"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "1h"
                kind: "query"
                name: "interval"
                orig: "interval"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "start"
                orig: "start"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/historical/{token_id}"
          parts: [
            "v1"
            "historical"
            "{id}"
          ]
          rename: {
            param: {
              token_id: "id"
            }
          }
          select: {
            exist: [
              "end"
              "id"
              "interval"
              "start"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
