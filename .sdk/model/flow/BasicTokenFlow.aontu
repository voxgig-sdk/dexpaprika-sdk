# BasicTokenFlow

main: kit: flow: BasicTokenFlow:
{
  entity: "token",
  kind: "basic",
  name: "BasicTokenFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "token_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "token_ref01",
        srcdatavar: "token_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "token01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-token_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTokenFlow"
}